{
  "name": "qtranslate",
  "version": "2.0.0",
  "description": "مترجم فوري لسطح المكتب - QTranslate",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder --win --x64",
    "package": "electron-packager . QTranslate --platform=win32 --arch=x64 --out=dist-pkg --overwrite --ignore=dist --ignore=dist-pkg --icon=assets/icon.ico"
  },
  "keywords": ["translate", "qtranslate", "electron", "ocr"],
  "author": "QTranslate",
  "license": "MIT",
  "build": {
    "appId": "com.qtranslate.app",
    "productName": "QTranslate",
    "copyright": "QTranslate 2024",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-popup.js",
      "preload-ocr.js",
      "preload-clip-icon.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QTranslate",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "language": "1025"
    },
    "portable": {
      "artifactName": "QTranslate-Portable.exe"
    }
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  }
}
